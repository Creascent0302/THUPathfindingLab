# Copy to /etc/pathlab.env and replace the public address.
PATHLAB_PUBLIC_URL=https://lab.example.edu
# One running experiment per student; batch tasks share this allowance.
PATHLAB_USER_RUNS=1
# For a smaller class/server, start with 10 and increase after load testing.
PATHLAB_TOTAL_RUNS=30
PATHLAB_USER_STORAGE_GB=2
# Includes user data and in-flight write reservations. This is a ceiling,
# not a preallocation; the server also checks actual free disk space.
PATHLAB_TOTAL_STORAGE_GB=80
