<?xml version="1.0"?>
<package format="2">
  <name>ros_line_follower</name>
  <version>0.1.0</version>
  <description>Calibrated temporal line tracking with native vehicle Goal output.</description>
  <maintainer email="maintainer@example.invalid">Pathfinding Lab</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>roslib</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <exec_depend>cav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
</package>
