<svg xmlns="http://www.w3.org/2000/svg" width="1400" height="900">
  <defs>
    <style>
      .box { fill:#ffffff; stroke:#000000; stroke-width:1.2; }
      .title { font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; }
      .text { font-family:Arial,Helvetica,sans-serif; font-size:12px; }
      .group-title { font-family:Arial,Helvetica,sans-serif; font-size:14px; font-weight:bold; fill:#000000; }
      .arrow { stroke:#000000; stroke-width:1.0; fill:none; marker-end:url(#arrowhead); }
    </style>
    <marker id="arrowhead" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
      <polygon points="0 0, 6 3, 0 6" fill="#000000" />
    </marker>
  </defs>

  <!-- ======= Overall Node ======= -->
  <rect x="20" y="20" width="1360" height="860" fill="#f7f7f7" stroke="#000000" stroke-width="1.5"/>
  <text x="30" y="45" class="group-title">ROS Node: drivableArea (dr_detect.cpp)</text>

  <!-- ======= Left: ROS Inputs ======= -->
  <rect x="40" y="80" width="260" height="210" class="box"/>
  <text x="50" y="100" class="title">Sensor & State Inputs (ROS)</text>

  <text x="55" y="125" class="text">/vehicle/vehicle_state</text>
  <text x="60" y="140" class="text">→ read_stateCB()</text>
  <text x="60" y="155" class="text">  • 更新 utm_x, utm_y, utm_z</text>
  <text x="60" y="170" class="text">  • 更新 yaw, roll, pitch</text>
  <text x="60" y="185" class="text">  • push 到 vh_stack</text>

  <text x="55" y="210" class="text">/rslidar_points</text>
  <text x="60" y="225" class="text">→ lidar_sub()</text>
  <text x="60" y="240" class="text">  • 存入 lidar_msg</text>
  <text x="60" y="255" class="text">  • lidar_state = true</text>

  <text x="55" y="280" class="text">/cav_vehicle_list</text>
  <text x="60" y="295" class="text">→ veh_sub()</text>
  <text x="60" y="310" class="text">  • 存入 veh_msg</text>
  <text x="60" y="325" class="text">  • veh_state = true</text>

  <!-- ======= Middle-top: Main Loop ======= -->
  <rect x="340" y="80" width="380" height="140" class="box"/>
  <text x="350" y="100" class="title">Main Loop (while ros::ok())</text>

  <text x="355" y="125" class="text">• ros::spinOnce()</text>
  <text x="355" y="140" class="text">• if (lidar_state) → lidarmappedCB(lidar_msg)</text>
  <text x="355" y="155" class="text">• if (veh_state) → read_vehCB(veh_msg)</text>
  <text x="355" y="170" class="text">• Loc_mapPB(sub_map)</text>
  <text x="355" y="185" class="text">• Occ_mapPB(sub_map)</text>
  <text x="355" y="200" class="text">• 重置 veh_state / lidar_state</text>

  <!-- Arrow from Inputs to Loop -->
  <line x1="300" y1="185" x2="340" y2="185" class="arrow"/>

  <!-- ======= Middle: Object / Obstacle Mask Builder ======= -->
  <rect x="340" y="250" width="380" height="230" class="box"/>
  <text x="350" y="270" class="title">Object / Obstacle Mask on Grid</text>

  <text x="355" y="295" class="text">read_vehCB(ObjLstCom)</text>
  <text x="370" y="310" class="text">• 与 vh_stack 中 VehicleState 时间对齐</text>
  <text x="370" y="325" class="text">• 将车辆四边形投影到栅格 grid (cv::Mat)</text>
  <text x="370" y="340" class="text">• flip + 遍历像素 → sub_map[i]=100 (被车辆占据)</text>

  <text x="355" y="365" class="text">read_objCB(RsPerceptionMsg)  (当前注释掉)</text>
  <text x="370" y="380" class="text">• 使用多边形语义目标 SupInfo.polygon</text>
  <text x="370" y="395" class="text">• 位姿变换 + 投影到栅格 → sub_map[i]=1</text>

  <text x="355" y="420" class="text">sub_map: float[MAP_SIZE²]</text>
  <text x="370" y="435" class="text">• 记录语义/车辆障碍占用</text>
  <text x="370" y="450" class="text">• 由 perception / xperception 提供的障碍信息</text>

  <!-- Arrow from Loop to Object Mask Builder -->
  <line x1="530" y1="220" x2="530" y2="250" class="arrow"/>

  <!-- ======= Right-top: LiDAR Drivable Detection Pipeline ======= -->
  <rect x="760" y="80" width="600" height="460" class="box"/>
  <text x="770" y="100" class="title">LiDAR Drivable Detection (DRIVABLE_DETECT_MAPPED, drivable_detect.cpp)</text>

  <!-- Sub-block: data_read + filterPC -->
  <rect x="770" y="115" width="280" height="90" class="box"/>
  <text x="780" y="135" class="title">1. Input & Filtering</text>
  <text x="785" y="155" class="text">data_read(cloud_in, cloud_out, utm_loc, heading)</text>
  <text x="785" y="170" class="text">filterPC(X_low, X_high, Y_low, Y_high, Z_thre, RANGE, VOXEL)</text>
  <text x="795" y="185" class="text">• 去 NaN / ROI 裁剪 / 距离过滤</text>
  <text x="795" y="200" class="text">• 估计 near_ground_height, min_ground_height</text>

  <!-- Sub-block: ini + mapping -->
  <rect x="1070" y="115" width="280" height="120" class="box"/>
  <text x="1080" y="135" class="title">2. Map Init & Multi-frame Mapping</text>
  <text x="1085" y="155" class="text">ini()</text>
  <text x="1095" y="170" class="text">• 清空 available/feasible 等集合</text>
  <text x="1095" y="185" class="text">• 根据 utm 位移将 pre_* 栅格平移到当前坐标</text>
  <text x="1095" y="200" class="text">• 将 cloud_prcs 旋转 + 平移到地图坐标</text>
  <text x="1085" y="220" class="text">mapping(N_FRAME)</text>
  <text x="1095" y="235" class="text">• 多帧累积：cloud_frames → cloud_prcs</text>

  <!-- Sub-block: movePC2Grid -->
  <rect x="770" y="220" width="280" height="90" class="box"/>
  <text x="780" y="240" class="title">3. Point → Grid Assignment</text>
  <text x="785" y="260" class="text">movePC2Grid()</text>
  <text x="795" y="275" class="text">• 遍历 cloud_prcs</text>
  <text x="795" y="290" class="text">• xy2IJ(x,y) → grid_array[i]-&gt;pc_ptr</text>

  <!-- Sub-block: Geometry / Flatness -->
  <rect x="1070" y="250" width="280" height="140" class="box"/>
  <text x="1080" y="270" class="title">4. Geometry & Flatness Analysis</text>
  <text x="1085" y="290" class="text">checkFlatness()</text>
  <text x="1095" y="305" class="text">• 每个栅格 PCA:</text>
  <text x="1105" y="320" class="text">– 质心 + 协方差矩阵 + 特征值/特征向量</text>
  <text x="1105" y="335" class="text">– slope_map: acos(|normal.z|)</text>
  <text x="1105" y="350" class="text">– rough_map: 平面残差 d_avg</text>
  <text x="1105" y="365" class="text">– hei_grid / hei_diff_grid</text>
  <text x="1095" y="380" class="text">• 基于几何特征更新 occ_grid</text>
  <text x="1095" y="395" class="text">• 标记 flat / non_flat / non_ground</text>

  <!-- Sub-block: Height adjustment -->
  <rect x="770" y="320" width="280" height="70" class="box"/>
  <text x="780" y="340" class="title">5. Height-based Adjustment</text>
  <text x="785" y="360" class="text">checkHeight()</text>
  <text x="795" y="375" class="text">• 对 non_ground_grid 进一步修改 occ_grid</text>

  <!-- Sub-block: Unocclusion (ray casting) -->
  <rect x="770" y="400" width="280" height="80" class="box"/>
  <text x="780" y="420" class="title">6. Unocclusion Estimation (Ray Casting)</text>
  <text x="785" y="440" class="text">checkUnocclusion() / updateUnocclusion()</text>
  <text x="795" y="455" class="text">• 从中心栅格向每个观测栅格画射线</text>
  <text x="795" y="470" class="text">• 更新 unocc_grid, mean_xy, mse_cover</text>
  <text x="785" y="485" class="text">(在 lidarmappedCB 中目前被注释掉)</text>

  <!-- Sub-block: CVaR + final -->
  <rect x="1070" y="410" width="280" height="120" class="box"/>
  <text x="1080" y="430" class="title">7. Risk Aggregation & Output</text>
  <text x="1085" y="450" class="text">make_final_decision()</text>
  <text x="1095" y="465" class="text">• multi_map 各个 layer 赋值：</text>
  <text x="1105" y="480" class="text">– elevation, unocc, mean_x/y, mse_cover</text>
  <text x="1105" y="495" class="text">– hei_diff, slope, step, collision</text>
  <text x="1095" y="510" class="text">• compute_cvar({"slope","step","collision"})</text>
  <text x="1105" y="525" class="text">– CUDA: computeCVaRCUDAWrapper(...)</text>
  <text x="1105" y="540" class="text">– 结果写入 multi_map["CVaR"]</text>
  <text x="1095" y="555" class="text">• 复制当前栅格到 pre_*，用于下一帧</text>

  <!-- Arrow: main loop → LiDAR pipeline (lidarmappedCB) -->
  <line x1="720" y1="150" x2="760" y2="150" class="arrow"/>
  <text x="730" y="145" class="text">lidarmappedCB()</text>

  <!-- Arrow: VehicleState → LiDAR & Object -->
  <line x1="170" y1="185" x2="170" y2="430" class="arrow"/>
  <line x1="170" y1="430" x2="340" y2="430" class="arrow"/>
  <text x="70" y="410" class="text">vh_stack</text>

  <line x1="300" y1="140" x2="760" y2="120" class="arrow"/>
  <text x="420" y="130" class="text">utm_loc, yaw → data_read()</text>

  <!-- Arrow: sub_map 与 LiDAR模块交互 -->
  <line x1="530" y1="440" x2="760" y2="440" class="arrow"/>
  <text x="540" y="435" class="text">sub_map (经 getGridMapPtr)</text>

  <!-- ======= Bottom-left: Map Publishers ======= -->
  <rect x="40" y="520" width="680" height="180" class="box"/>
  <text x="50" y="540" class="title">Map & Point Cloud Outputs</text>

  <text x="55" y="565" class="text">Filter_pcPB(detect_mapped.cloud_prcs)</text>
  <text x="70" y="580" class="text">→ /drivable/filtered_point_cloud (sensor_msgs::PointCloud2)</text>

  <text x="55" y="605" class="text">Pc_outputPB(cloud_mapped_out)  (当前注释)</text>
  <text x="70" y="620" class="text">→ /drivable/ground_point_cloud</text>

  <text x="55" y="645" class="text">Hei_mapPB(detect_mapped.hei_grid)</text>
  <text x="70" y="660" class="text">→ /drivable/Hei_map (nav_msgs::OccupancyGrid)</text>

  <text x="355" y="565" class="text">grid_map::GridMapRosConverter::toMessage(multi_map)</text>
  <text x="370" y="580" class="text">→ /grid_map (grid_map_msgs::GridMap)</text>

  <text x="355" y="605" class="text">Loc_mapPB(sub_map)</text>
  <text x="370" y="620" class="text">→ /cav_local_map (LocalMap_msgs::LocalMap)</text>
  <text x="370" y="635" class="text">  • driveable_index: sub_map[i] &gt; 80</text>
  <text x="370" y="650" class="text">  • driveable_value: 1 - CVaR(i)</text>

  <text x="355" y="675" class="text">Occ_mapPB(sub_map)</text>
  <text x="370" y="690" class="text">→ /drivable/occ_map (nav_msgs::OccupancyGrid)</text>
  <text x="370" y="705" class="text">  • 同步 detect_mapped.pre_occ_grid</text>

  <!-- Arrows from LiDAR pipeline & sub_map to outputs -->
  <line x1="820" y1="540" x2="720" y2="540" class="arrow"/>
  <text x="790" y="535" class="text">multi_map</text>

  <line x1="380" y1="480" x2="380" y2="520" class="arrow"/>
  <text x="320" y="515" class="text">sub_map</text>

</svg>