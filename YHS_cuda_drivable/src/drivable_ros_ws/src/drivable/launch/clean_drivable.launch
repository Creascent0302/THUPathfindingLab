<launch>
    
    <param name="scan_line" type="int" value="32" />
    <param name="mapping_frame_num" type="int" value="1" />
    <param name="map_size" type="int" value="307" />
    <param name="grid_size" type="double" value="0.1" />
    <param name="down_sample" type="double" value="0.1"/>
    <param name="X_LOW" type="double" value="1.5" />
    <param name="X_HIGH" type="double" value="0.8" />
    <param name="Y_LOW" type="double" value="0.6" />
    <param name="Y_HIGH" type="double" value="0.6" />
    <param name="Z_THD" type="double" value="0.2"/>
    <!-- 车辆中心在雷达坐标系下的位置 (x前 y左, m)；p_body = p_lidar - offset，实车 -0.6 表示中心在雷达后方 0.6m -->
    <param name="lidar_offset_x" type="double" value="-0.6"/>
    <param name="lidar_offset_y" type="double" value="0.0"/>
    <!-- 是否套用上面的 lidar→车体外参。判据是 VehicleState 的 x/y 指向哪个点：
         实测关闭时墙仍整体摆动且远近幅度相同，说明 utm_loc 不是雷达位置，
         而是离雷达 0.6m 的车辆中心，这个杠杆臂必须由外参抵消 -->
    <param name="apply_lidar_extrinsic" type="bool" value="true"/>
    <!-- 点云输入话题：
         /rslidar_points                 = 雷达原始输出，带运动畸变
         /lio_sam/deskew/cloud_deskewed  = LIO-SAM 用 IMU 去过畸变的点云（对照实验用） -->
    <param name="lidar_topic" type="string" value="/lio_sam/deskew/cloud_deskewed"/>
    <!-- 单帧扫描内的运动畸变补偿：按逐点时间戳把点投影回 header.stamp 时刻。
         需要点云带 timestamp/time/t 字段。
         用 LIO-SAM 已去畸变的话题时必须 false，否则会二次补偿 -->
    <param name="deskew_enable" type="bool" value="false"/>
    <!-- header.stamp 到扫描参考时刻的修正（秒）。若驱动用扫描起点打戳，可试 0.05 -->
    <param name="lidar_time_offset_sec" type="double" value="0.0"/>
    <!-- heading 来源与延迟补偿：
         false = 定位模块 heading（与点云同 timestamp），不补偿 xyz/heading
         true  = GPS heading，启用 heading_latency_sec 的 yaw_rate 前向补偿 -->
    <param name="heading_from_gps" type="bool" value="false"/>
    <!-- 仅 heading_from_gps=true 时生效 -->
    <param name="heading_latency_sec" type="double" value="0.06"/>
    <!-- true: 由 VehicleState 驱动。收到 heading 后回头取它当初据以计算的那帧点云，
              位姿直接采用、不插值不外推。这样消除了"用上一帧 heading 配当前点云"
              造成的整整一帧滞后（转弯时表现为 omega*100ms 的墙面倾斜）
         false: 旧行为，点云到达即处理，位姿靠插值/外推 -->
    <param name="pose_driven_sync" type="bool" value="true"/>
    <!-- 残余滞后微调（秒）。pose_driven_sync=true 时配对已经结构性地解决了滞后，
         应保持 0；只有实测仍有倾斜时才用它做最后的微调 -->
    <param name="state_latency_sec" type="double" value="0.0"/>
    <!-- 障碍记忆保留时长（秒）；直行时墙/障碍在此时间内保持 -->
    <param name="obstacle_ttl_sec" type="double" value="5.0"/>
    <!-- true: 点云在自车坐标系处理，用 VehicleState.heading 旋到 ENU，再输出 UTM（默认）
         false: 点云已是相对车辆的 ENU，只做 UTM 平移 -->
    <param name="lidar_in_body_frame" type="bool" value="true"/>
    <!-- if 1, do mapping 10 Hz, if 2, do mapping 5 Hz. Suggest to use 1, it will adjust frequence automaticlly -->
    <param name="RANGE" type="double" value="40.0" />
    <param name="mapping_skip_frame" type="int" value="1" />


    <node pkg="drivable_area_detection" type="clear_test" name="ground_point_cloud" output="screen"/>
    
   
    <arg name="rviz" default="true" />
    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find drivable_area_detection)/rviz_cfg/rtk_pc_map.rviz" />
    </group>

</launch>

