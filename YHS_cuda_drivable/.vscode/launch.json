{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug drivable_node",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/devel/lib/drivable_area_detection/clear_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Load debug symbols", 
                    "text": "file ${workspaceFolder}/devel/lib/drivable_area_detection/clear_test",
                    "ignoreFailures": true
                },
                {
                    "description": "Handle BFD errors",
                    "text": "set complaints 0",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "catkin build"
        },
        {
            "name": "Attach to drivable_node",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/devel/lib/drivable_area_detection/clear_test",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
